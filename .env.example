# Salin jadi ".env" lalu isi. JANGAN commit file .env (sudah di .gitignore).

# Wajib salah satu (boleh dua-duanya) supaya fitur AI (judul/caption/hashtag/script/
# analisis momen video) benar-benar jalan. Tanpa keduanya, aplikasi tetap jalan
# penuh dalam Demo Mode (FFmpeg tetap nyata, cuma judul AI-nya pakai contoh generik).

# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# https://aistudio.google.com/apikey — dipakai juga untuk transkripsi audio (Auto Subtitle),
# karena satu-satunya provider di sini yang mendukung input audio langsung.
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional
PORT=4000
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang
