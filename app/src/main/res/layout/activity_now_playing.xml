<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:paddingHorizontal="@dimen/spacing_lg">

    <ImageButton
        android:id="@+id/nowPlayingBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/nowPlayingFavorite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_favorite"
        android:src="@drawable/ic_favorite_border"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/nowPlayingOverflow" />

    <ImageButton
        android:id="@+id/nowPlayingOverflow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_more_options"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/nowPlayingArt"
        android:layout_width="@dimen/album_art_size_now_playing"
        android:layout_height="@dimen/album_art_size_now_playing"
        android:layout_marginTop="@dimen/spacing_xl"
        android:background="@color/surface_dark_elevated"
        android:elevation="@dimen/elevation_now_playing_art"
        android:padding="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:contentDescription="@string/cd_album_art"
        app:shapeAppearanceOverlay="@style/RoundedNowPlayingArt"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nowPlayingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_title_large"
        android:textStyle="bold"
        tools:text="Song Title Goes Here"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingArt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nowPlayingArtistAlbum"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_body"
        tools:text="Artist • Album"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/nowPlayingSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:max="1000"
        android:progressTint="@color/blue_accent"
        android:progressBackgroundTint="@color/divider"
        android:thumbTint="@color/blue_accent"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingArtistAlbum"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nowPlayingCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_caption"
        tools:text="0:00"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingSeekBar"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/nowPlayingTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_caption"
        tools:text="3:45"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingSeekBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/nowPlayingShuffle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_shuffle"
        android:padding="8dp"
        android:src="@drawable/ic_shuffle"
        app:tint="@color/icon_inactive"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingCurrentTime"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/nowPlayingRepeat"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_repeat"
        android:padding="8dp"
        android:src="@drawable/ic_repeat"
        app:tint="@color/icon_inactive"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingTotalTime"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/nowPlayingPrevious"
        style="@style/TransportButtonStyle"
        android:layout_width="@dimen/transport_button_size"
        android:layout_height="@dimen/transport_button_size"
        android:layout_marginTop="@dimen/spacing_md"
        android:contentDescription="@string/action_previous"
        android:src="@drawable/ic_previous"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingShuffle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/nowPlayingRewind"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <ImageButton
        android:id="@+id/nowPlayingRewind"
        style="@style/TransportButtonStyle"
        android:layout_width="@dimen/transport_button_size"
        android:layout_height="@dimen/transport_button_size"
        android:layout_marginStart="@dimen/spacing_md"
        android:contentDescription="@string/action_rewind"
        android:src="@drawable/ic_rewind"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/nowPlayingPrevious"
        app:layout_constraintBottom_toBottomOf="@id/nowPlayingPrevious"
        app:layout_constraintStart_toEndOf="@id/nowPlayingPrevious"
        app:layout_constraintEnd_toStartOf="@id/nowPlayingPlayPause" />

    <ImageButton
        android:id="@+id/nowPlayingPlayPause"
        style="@style/PlayButtonStyle"
        android:layout_width="@dimen/play_button_size"
        android:layout_height="@dimen/play_button_size"
        android:layout_marginStart="@dimen/spacing_md"
        android:src="@drawable/ic_pause"
        app:tint="@color/text_on_accent"
        app:layout_constraintTop_toTopOf="@id/nowPlayingPrevious"
        app:layout_constraintBottom_toBottomOf="@id/nowPlayingPrevious"
        app:layout_constraintStart_toEndOf="@id/nowPlayingRewind"
        app:layout_constraintEnd_toStartOf="@id/nowPlayingFastForward" />

    <ImageButton
        android:id="@+id/nowPlayingFastForward"
        style="@style/TransportButtonStyle"
        android:layout_width="@dimen/transport_button_size"
        android:layout_height="@dimen/transport_button_size"
        android:layout_marginStart="@dimen/spacing_md"
        android:contentDescription="@string/action_fast_forward"
        android:src="@drawable/ic_fast_forward"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/nowPlayingPrevious"
        app:layout_constraintBottom_toBottomOf="@id/nowPlayingPrevious"
        app:layout_constraintStart_toEndOf="@id/nowPlayingPlayPause"
        app:layout_constraintEnd_toStartOf="@id/nowPlayingNext" />

    <ImageButton
        android:id="@+id/nowPlayingNext"
        style="@style/TransportButtonStyle"
        android:layout_width="@dimen/transport_button_size"
        android:layout_height="@dimen/transport_button_size"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:contentDescription="@string/action_next"
        android:src="@drawable/ic_next"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/nowPlayingPrevious"
        app:layout_constraintBottom_toBottomOf="@id/nowPlayingPrevious"
        app:layout_constraintStart_toEndOf="@id/nowPlayingFastForward"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
