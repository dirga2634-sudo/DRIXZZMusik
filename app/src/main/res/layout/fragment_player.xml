<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_down"
                android:padding="4dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sedang Diputar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:gravity="center"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>
        </LinearLayout>

        <!-- Album Art -->
        <ImageView
            android:id="@+id/iv_album_art"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_music_placeholder"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_album_art"
            android:layout_marginBottom="24dp"/>

        <!-- Title and Favorite -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Judul Lagu"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Artis"
                    android:textSize="13sp"
                    android:textColor="@color/text_dim"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_heart"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Seekbar -->
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/green"
            android:thumbTint="@color/green"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/text_dim"/>

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/text_dim"/>
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_skip_prev"
                android:padding="8dp"/>

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_play"
                android:padding="8dp"
                android:background="@drawable/bg_play_btn"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_skip_next"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Extra buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_lyrics"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_lyrics"
                android:padding="8dp"
                android:alpha="0.5"
                android:layout_marginEnd="24dp"/>

            <ImageView
                android:id="@+id/btn_eq"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_equalizer"
                android:padding="8dp"
                android:alpha="0.5"/>
        </LinearLayout>

        <!-- Lyrics Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_lyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIRIK"
                    android:textSize="11sp"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lirik tidak tersedia"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Equalizer Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_equalizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EQUALIZER"
                    android:textSize="11sp"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <!-- Preset buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/btn_eq_flat"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Flat"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_btn_outline_green"
                        android:layout_margin="3dp"/>

                    <TextView
                        android:id="@+id/btn_eq_bass"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Bass"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_btn_outline_green"
                        android:layout_margin="3dp"/>

                    <TextView
                        android:id="@+id/btn_eq_pop"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Pop"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_btn_outline_green"
                        android:layout_margin="3dp"/>

                    <TextView
                        android:id="@+id/btn_eq_rock"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Rock"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_btn_outline_green"
                        android:layout_margin="3dp"/>
                </LinearLayout>

                <!-- EQ Bands -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/eq_60hz" android:layout_width="100dp" android:layout_height="wrap_content" android:rotation="270" android:progressTint="@color/green" android:thumbTint="@color/green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60Hz" android:textSize="9sp" android:textColor="@color/text_dim" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/eq_230hz" android:layout_width="100dp" android:layout_height="wrap_content" android:rotation="270" android:progressTint="@color/green" android:thumbTint="@color/green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="230Hz" android:textSize="9sp" android:textColor="@color/text_dim" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/eq_910hz" android:layout_width="100dp" android:layout_height="wrap_content" android:rotation="270" android:progressTint="@color/green" android:thumbTint="@color/green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="910Hz" android:textSize="9sp" android:textColor="@color/text_dim" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/eq_4khz" android:layout_width="100dp" android:layout_height="wrap_content" android:rotation="270" android:progressTint="@color/green" android:thumbTint="@color/green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4kHz" android:textSize="9sp" android:textColor="@color/text_dim" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/eq_14khz" android:layout_width="100dp" android:layout_height="wrap_content" android:rotation="270" android:progressTint="@color/green" android:thumbTint="@color/green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14kHz" android:textSize="9sp" android:textColor="@color/text_dim" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Bass Boost -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bass Boost"
                    android:textSize="12sp"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/seek_bass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/green"
                        android:thumbTint="@color/green"/>

                    <TextView
                        android:id="@+id/tv_bass_value"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="11sp"
                        android:textColor="@color/text_dim"
                        android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
