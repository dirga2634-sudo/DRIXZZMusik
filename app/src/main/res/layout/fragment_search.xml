<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cari"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"/>

    <!-- Search bar Spotify style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/text"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- Search icon -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:colorFilter="@color/bg"
            android:layout_marginEnd="10dp"/>

        <!-- Input -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Artis, lagu, atau podcast"
            android:textColor="@color/bg"
            android:textColorHint="#767676"
            android:textSize="14sp"
            android:background="@null"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textStyle="bold"/>

        <!-- Clear button -->
        <ImageView
            android:id="@+id/btn_clear"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_more"
            android:colorFilter="@color/bg"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Browse label (shown when empty) -->
    <TextView
        android:id="@+id/tv_browse_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jelajahi semua"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:paddingStart="16dp"
        android:paddingBottom="14dp"/>

    <!-- Result count / status -->
    <TextView
        android:id="@+id/tv_result_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_dim"
        android:paddingStart="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"/>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/green"
        android:layout_marginTop="32dp"
        android:visibility="gone"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:padding="32dp"
        android:visibility="gone"/>

    <!-- Results -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</LinearLayout>
