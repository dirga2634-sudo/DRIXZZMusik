<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginVertical="@dimen/spacing_xs"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="0dp"
    app:rippleColor="@color/blue_accent_ripple"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_sm">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/songItemArt"
            android:layout_width="@dimen/album_art_size_list"
            android:layout_height="@dimen/album_art_size_list"
            android:background="@color/surface_dark_elevated"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:contentDescription="@string/cd_album_art"
            app:shapeAppearanceOverlay="@style/RoundedListArt"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/songItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="Song Title"
            app:layout_constraintTop_toTopOf="@id/songItemArt"
            app:layout_constraintStart_toEndOf="@id/songItemArt"
            app:layout_constraintEnd_toStartOf="@id/songItemFavoriteIcon" />

        <TextView
            android:id="@+id/songItemArtistAlbum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            tools:text="Artist • Album"
            app:layout_constraintTop_toBottomOf="@id/songItemTitle"
            app:layout_constraintStart_toEndOf="@id/songItemArt"
            app:layout_constraintEnd_toStartOf="@id/songItemFavoriteIcon" />

        <TextView
            android:id="@+id/songItemDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_disabled"
            android:textSize="@dimen/text_size_caption"
            tools:text="3:45"
            app:layout_constraintTop_toBottomOf="@id/songItemArtistAlbum"
            app:layout_constraintStart_toEndOf="@id/songItemArt" />

        <TextView
            android:id="@+id/songItemSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_disabled"
            android:textSize="@dimen/text_size_caption"
            tools:text=" • 4.2 MB"
            app:layout_constraintTop_toBottomOf="@id/songItemArtistAlbum"
            app:layout_constraintStart_toEndOf="@id/songItemDuration" />

        <ImageView
            android:id="@+id/songItemFavoriteIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/icon_inactive"
            android:contentDescription="@string/action_favorite"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/songItemMenuButton" />

        <ImageButton
            android:id="@+id/songItemMenuButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/action_more_options"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
