# Salin file ini menjadi ".env" lalu isi nilai di bawah.
# JANGAN PERNAH commit file ".env" (sudah ada di .gitignore).

# Wajib salah satu (boleh dua-duanya): tanpa keduanya, /api/chat tidak akan jalan sama sekali.

# API key dari https://openrouter.ai/keys — dipakai untuk semua model kecuali "Gemini Flash (langsung Google)".
OPENROUTER_API_KEY=your_openrouter_api_key_here

# API key dari https://aistudio.google.com/apikey — dipakai KHUSUS untuk model "Gemini Flash
# (langsung Google)", panggil API Google langsung (bukan lewat OpenRouter), pakai kuota gratis
# Google AI Studio sendiri. Kalau dikosongkan, model itu otomatis disembunyikan dari daftar/Auto.
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional: port server (default 3000)
PORT=3000

# Opsional: model default saat pertama kali dibuka (harus salah satu key di MODELS pada server.js)
DEFAULT_MODEL=auto:free

# Opsional: URL publik situs kamu, dikirim sebagai header HTTP-Referer ke OpenRouter
# (dipakai OpenRouter untuk atribusi di leaderboard mereka, bukan wajib untuk fungsi chat)
SITE_URL=http://localhost:3000

# Opsional: batasi asal (origin) yang boleh mengakses API, pisahkan dengan koma.
# Kosongkan/hapus baris ini jika frontend & backend selalu satu domain (default aman).
# ALLOWED_ORIGIN=https://roumai.com,https://www.roumai.com

# Opsional: maksimal request ke /api/chat per IP per 5 menit (default 40)
RATE_LIMIT_MAX=40
