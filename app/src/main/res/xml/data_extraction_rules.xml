<?xml version="1.0" encoding="utf-8"?>
<!--
    Aturan ekstraksi data untuk Android 12+ (API 31+), menggantikan
    full-backup-content untuk cloud backup & device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="music_player_prefs.xml" />
        <include domain="database" path="playlists.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="music_player_prefs.xml" />
        <include domain="database" path="playlists.db" />
    </device-transfer>
</data-extraction-rules>
